{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://rebulo.local/schemas/pictogram-prototype-briefs.schema.json",
  "title":"Rebulo pictogram prototype briefs",
  "description":"Human research briefs for useful whole-word pictogram candidates. Briefs are not assets, naming results, activation decisions, or clinical validation.",
  "type":"object","additionalProperties":false,"required":["schemaVersion","briefs"],
  "properties":{"schemaVersion":{"const":"1.0"},"briefs":{"type":"array","items":{"$ref":"#/$defs/brief"}}},
  "$defs":{"brief":{"type":"object","additionalProperties":false,"required":["concept","targetIpa","researchStatus","priorityEvidence","visualGoal","avoidCues","namingRisks","nextGate","automaticActivation"],"properties":{
    "concept":{"type":"string","minLength":1},"targetIpa":{"type":"string","minLength":1},
    "researchStatus":{"enum":["prototype_design","asset_search","naming_review"]},
    "priorityEvidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "visualGoal":{"type":"string","minLength":1},
    "avoidCues":{"type":"array","items":{"type":"string","minLength":1}},
    "namingRisks":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "nextGate":{"enum":["prototype_comparison","asset_review","naming_test_plan"]},
    "automaticActivation":{"const":false}
  }}}
}
